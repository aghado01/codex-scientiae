@article{li_2021_QuantitativeStabilityError,
  title = {Quantitative Stability and Error Estimates for Optimal Transport Plans},
  author = {Li, Wenbo and Nochetto, Ricardo H},
  year = 2021,
  month = jul,
  journal = {IMA Journal of Numerical Analysis},
  volume = {41},
  number = {3},
  pages = {1941--1965},
  issn = {0272-4979, 1464-3642},
  doi = {10.1093/imanum/draa045},
  urldate = {2026-03-22},
  abstract = {Abstract             Optimal transport maps and plans between two absolutely continuous measures \$\textbackslash mu\$ and \$\textbackslash nu\$ can be approximated by solving semidiscrete or fully discrete optimal transport problems. These two problems ensue from approximating \$\textbackslash mu\$ or both \$\textbackslash mu\$ and \$\textbackslash nu\$ by Dirac measures. Extending an idea from Gigli (2011, On Hölder continuity-in-time of the optimal transport map towards measures along a curve. Proc. Edinb. Math. Soc. (2), 54, 401–409), we characterize how transport plans change under the perturbation of both \$\textbackslash mu\$ and \$\textbackslash nu\$. We apply this insight to prove error estimates for semidiscrete and fully discrete algorithms in terms of errors solely arising from approximating measures. We obtain weighted \$L\textasciicircum 2\$ error estimates for both types of algorithms with a convergence rate \$O(h\textasciicircum\{1/2\})\$. This coincides with the rate in Theorem 5.4 in Berman (2018, Convergence rates for discretized Monge–Ampère equations and quantitative stability of optimal transport. Preprint available at arXiv:1803.00785) for semidiscrete methods, but the error notion is different.},
  copyright = {https://academic.oup.com/journals/pages/open\_access/funder\_policies/chorus/standard\_publication\_model},
  langid = {english}
}

