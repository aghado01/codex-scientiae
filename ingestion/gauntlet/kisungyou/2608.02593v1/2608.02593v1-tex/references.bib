@article{jin_2019_DoublyLatentSpace,
  title = {A {{Doubly Latent Space Joint Model}} for {{Local Item}} and {{Person Dependence}} in the {{Analysis}} of {{Item Response Data}}},
  author = {Jin, Ick Hoon and Jeon, Minjeong},
  year = 2019,
