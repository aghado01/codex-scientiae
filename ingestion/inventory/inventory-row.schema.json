{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-scientiae/document-inventory-row/0.1",
  "title": "Codex Scientiae localized document inventory row",
  "type": "object",
  "required": [
    "schema",
    "document_parent",
    "metadata_path",
    "metadata_sha256",
    "manifest_schema",
    "state",
    "slug",
    "document"
  ],
  "properties": {
    "schema": { "const": "codex-scientiae/document-inventory-row/0.1" },
    "document_parent": { "$ref": "#/$defs/scopedRelativePath" },
    "metadata_path": { "$ref": "#/$defs/scopedRelativePath" },
    "metadata_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_schema": { "const": "codex-scientiae/document-metadata/0.1" },
    "state": { "const": "source-ready" },
    "slug": { "type": "string", "minLength": 1 },
    "document": {
      "type": "object",
      "required": ["title", "authors", "abstract", "identifiers", "categories"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "authors": { "type": "array", "items": { "type": "string" } },
        "abstract": { "type": ["string", "null"] },
        "identifiers": { "type": "object" },
        "categories": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "scopedRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
