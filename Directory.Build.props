<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <ArtifactsRoot>$(RepositoryRoot)artifacts\</ArtifactsRoot>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <DefineConstants Condition="'$(ExtraDefineConstants)' != ''">$(DefineConstants);$(ExtraDefineConstants)</DefineConstants>

    <!-- Artifacts are scoped by module first: artifacts\{module}\{bin,obj}\{project}\. Nothing
         writes a bare artifacts\bin or artifacts\obj, because artifacts\ is shared with every
         other process that emits regenerable output (test runs, publish staging, npm caches,
         tectonic, latex-ingest) and an unscoped top-level bin\ collides with all of them.
         The module is the project's own directory name, which under the brewery\{module}\**
         layout is exactly the module it belongs to — so the three doccer projects land together
         under artifacts\doccer with no per-project boilerplate. Override with
         /p:ArtifactsModule=... on the command line: that arrives as a global property before
         evaluation, whereas setting it in the csproj body would be too late, since the two paths
         below expand where they are written. -->
    <ArtifactsModule Condition="'$(ArtifactsModule)' == ''">$([System.IO.Path]::GetFileName('$(MSBuildProjectDirectory)'))</ArtifactsModule>
    <BaseOutputPath>$(ArtifactsRoot)$(ArtifactsModule)\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(ArtifactsRoot)$(ArtifactsModule)\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Shared-source routing (repo convention). A codex C# tool keeps its code under
       src\{tool} and a thin .csproj in its brewery recipe at brewery\{module}\; the
       project compiles the sources at src\$(SharedSource). SharedSource defaults to the
       project name, so brewery\foo\foo.csproj auto-picks-up src\foo with no boilerplate.
       Override it to point elsewhere (a test project compiling the library it exercises
       sets <SharedSource>foo</SharedSource>), or set EnableSharedSourceRouting=false to
       opt a project out entirely. Sibling projects of one module share a directory, so a
       project routed this way that also carries its own entry point should disable the
       default compile glob — see brewery\hdbscan\hdbscan.tests.csproj. Items resolve
       after all properties, so the per-csproj override wins even though this block lives
       in the imported props. -->
  <PropertyGroup>
    <SharedSource Condition="'$(SharedSource)' == '' AND '$(EnableSharedSourceRouting)' != 'false'">$(MSBuildProjectName)</SharedSource>
  </PropertyGroup>
  <ItemGroup Condition="'$(SharedSource)' != '' AND Exists('$(RepositoryRoot)src\$(SharedSource)')">
    <Compile Include="$(RepositoryRoot)src\$(SharedSource)\**\*.cs" />
  </ItemGroup>
</Project>
