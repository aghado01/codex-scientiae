<Project Sdk="Microsoft.NET.Sdk">

  <!-- Closed-form HDBSCAN lift from SPCX, plus a smoke Main for verification.
       To integrate as a library: delete Program.cs and set OutputType to Library. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HdbscanSmoke</AssemblyName>
  </PropertyGroup>

</Project>
