    { "glyph": "rceil", "latex": "\\rceil" },
    { "glyph": "−", "latex": "-" },
    { "glyph": "∗", "latex": "*" },
    { "glyph": "★", "latex": "\\star" },
    { "glyph": "′", "latex": "'" },
    { "glyph": "↓", "latex": "\\downarrow" },
    { "glyph": "↑", "latex": "\\uparrow" },
    { "glyph": "≍", "latex": "\\asymp" },
    { "glyph": "≲", "latex": "\\lesssim" },
    { "glyph": "≳", "latex": "\\gtrsim" },
    { "glyph": "⊤", "latex": "\\top" },
