{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "_description": "Canonical Math Register target store: normative transformations, aliases, unicode glyph mappings, and furniture patterns.",
  "prose_masks": [
    { "id": "text_body", "pattern": "\\\\text\\s*\\{[^{}]*\\}" }
  ],
  "operator_lowerings": [
    {
      "id": "operatorname",
      "pattern": "\\\\operatorname\\s*\\*?\\s*\\{\\s*([^{}]*?)\\s*\\}",
      "replacement": "\\mathrm{$1}"
    }
  ],
  "aliases": [
    { "canonical": "\\geq", "members": ["\\ge", "\\geqslant"] },
    { "canonical": "\\leq", "members": ["\\le", "\\leqslant"] },
    { "canonical": "\\neq", "members": ["\\ne"] },
    { "canonical": "\\to", "members": ["\\rightarrow"] },
    { "canonical": "\\frac", "members": ["\\dfrac", "\\tfrac"] }
  ],
  "furniture_patterns": [
    {
      "id": "textcolor",
      "pattern": "\\\\textcolor\\s*(?:\\[[^\\]]*\\])?\\s*\\{[^{}]*\\}\\s*(?=\\{)",
      "replacement": ""
    },
    {
      "id": "color",
      "pattern": "\\\\color\\s*(?:\\[[^\\]]*\\])?\\s*\\{[^{}]*\\}",
      "replacement": ""
    },
    {
      "id": "spacing",
      "pattern": "\\\\[vh]space\\*?\\s*\\{[^{}]*\\}",
      "replacement": ""
    },
    {
      "id": "breaks",
      "pattern": "\\\\(?:smallskip|medskip|bigskip|noindent)(?![a-zA-Z])",
      "replacement": ""
    },
    {
      "id": "negative_kerning",
      "pattern": "\\\\!",
      "replacement": ""
    },
    {
      "id": "inline_displaystyle",
      "pattern": "\\\\displaystyle(?![a-zA-Z])\\s*",
      "replacement": "",
      "scope": "inline"
    }
  ],
  "cleanups": [
    {
      "id": "nested_braces",
      "pattern": "\\{\\s*\\{([^{}]*)\\}\\s*\\}",
      "replacement": "{$1}",
      "loop": true
    },
    {
      "id": "whitespace_seams",
      "pattern": "[ \\t]{2,}",
      "replacement": " "
    }
  ],
  "unicode_glyphs": [
    { "glyph": "α", "latex": "\\alpha" },
    { "glyph": "β", "latex": "\\beta" },
    { "glyph": "γ", "latex": "\\gamma" },
    { "glyph": "δ", "latex": "\\delta" },
    { "glyph": "ε", "latex": "\\varepsilon" },
    { "glyph": "ζ", "latex": "\\zeta" },
    { "glyph": "η", "latex": "\\eta" },
    { "glyph": "θ", "latex": "\\theta" },
    { "glyph": "ι", "latex": "\\iota" },
    { "glyph": "κ", "latex": "\\kappa" },
    { "glyph": "λ", "latex": "\\lambda" },
    { "glyph": "μ", "latex": "\\mu" },
    { "glyph": "ν", "latex": "\\nu" },
    { "glyph": "ξ", "latex": "\\xi" },
    { "glyph": "o", "latex": "o" },
    { "glyph": "π", "latex": "\\pi" },
    { "glyph": "ρ", "latex": "\\rho" },
    { "glyph": "ς", "latex": "\\varsigma" },
    { "glyph": "σ", "latex": "\\sigma" },
    { "glyph": "τ", "latex": "\\tau" },
    { "glyph": "υ", "latex": "\\upsilon" },
    { "glyph": "φ", "latex": "\\phi" },
    { "glyph": "χ", "latex": "\\chi" },
    { "glyph": "ψ", "latex": "\\psi" },
    { "glyph": "ω", "latex": "\\omega" },
    { "glyph": "Γ", "latex": "\\Gamma" },
    { "glyph": "Δ", "latex": "\\Delta" },
    { "glyph": "Θ", "latex": "\\Theta" },
    { "glyph": "Λ", "latex": "\\Lambda" },
    { "glyph": "Ξ", "latex": "\\Xi" },
