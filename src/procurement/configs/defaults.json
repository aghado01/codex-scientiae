{
  "version": 1,
  "default_sources": ["openalex", "semanticscholar", "arxiv", "zenodo"],
  "metadata_fallback_sources": ["semanticscholar", "openalex"],
  "provider_groups": {
    "aggregators": ["openalex", "semanticscholar"],
    "repositories": ["arxiv", "zenodo"],
    "access_sources": ["scihub"]
  },
  "providers": {
    "openalex": {
      "base_url": "https://api.openalex.org",
      "min_interval_seconds": 0.15,
      "timeout_seconds": 30,
      "max_attempts": 3
    },
    "semanticscholar": {
      "base_url": "https://api.semanticscholar.org/graph/v1",
      "secondary_base_url": "https://api.semanticscholar.org/recommendations/v1",
      "min_interval_seconds": 1.1,
      "timeout_seconds": 30,
      "max_attempts": 3
    },
    "arxiv": {
      "base_url": "https://export.arxiv.org/api/query",
      "artifact_base_url": "https://arxiv.org",
      "secondary_artifact_base_url": "https://export.arxiv.org",
      "min_interval_seconds": 3.0,
      "timeout_seconds": 30,
      "max_attempts": 3
    },
    "zenodo": {
      "base_url": "https://zenodo.org/api/records",
      "min_interval_seconds": 1.0,
      "timeout_seconds": 30,
      "max_attempts": 3
    }
  },
  "acquisition": {
    "staging_root": "ingestion/staging",
    "catalogs": [
      {
        "name": "inventory",
        "path": "ingestion/inventory"
      }
    ],
    "local_inboxes": [
      {
        "name": "manual",
        "path": "ingestion/imports"
      }
    ],
    "lock_timeout_seconds": 60,
    "limits": {
      "source_bytes": 4294967296,
      "pdf_bytes": 1073741824,
      "html_bytes": 134217728,
      "expanded_source_bytes": 4294967296,
      "archive_entries": 100000
    }
  }
}
