{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-scientiae/article/0.1",
  "title": "Codex Scientiae article manifest (provisional source-deposit shape)",
  "description": "One bounded object per deposited article, written atomically and last by the source-deposit transaction. Its presence is the success sentinel: state 'source-ready' means the deposit completed, not that conversion has run.",
  "type": "object",
  "required": [
    "schema",
    "state",
    "slug",
    "initialized_utc",
    "title",
    "authors",
    "abstract",
    "identifiers",
    "categories",
    "evidence",
    "source_forms",
    "validation"
  ],
  "x-identity": [
    "/slug"
  ],
  "properties": {
    "schema": {
      "const": "codex-scientiae/article/0.1"
    },
    "state": {
      "const": "source-ready"
    },
    "slug": {
      "$ref": "#/$defs/portableLeaf"
    },
    "initialized_utc": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abstract": {
      "type": [
        "string",
        "null"
      ]
    },
    "identifiers": {
      "type": "object",
      "required": [
        "arxiv",
        "arxiv_versioned",
        "doi"
      ],
      "properties": {
        "arxiv": {
          "type": [
            "string",
            "null"
          ]
        },
        "arxiv_versioned": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "description": "Aggregator subject concepts. These are not arXiv categories.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "primary_category": {
      "type": [
        "string",
        "null"
      ]
    },
    "published": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "provider_metadata",
        "latex_source",
        "package_control_files"
      ],
      "properties": {
        "provider_metadata": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/fileRecord"},
              {
                "if": {
                  "properties": {"role": {"const": "api-metadata-bundle"}},
                  "required": ["role"]
                },
                "then": {
                  "required": [
                    "provider",
                    "provider_roles",
                    "artifact_provider",
                    "artifact_provider_roles",
                    "route",
                    "fetched_at",
                    "response_url",
                    "response_format",
                    "response_sha256"
                  ],
                  "properties": {
                    "provider": {"type": "string", "minLength": 1},
                    "provider_roles": {
                      "type": "array",
                      "items": {"$ref": "#/$defs/providerRole"},
                      "uniqueItems": true
                    },
                    "artifact_provider_roles": {
                      "type": "array",
                      "contains": {"const": "artifact-access"},
                      "items": {"$ref": "#/$defs/providerRole"},
                      "uniqueItems": true
                    },
                    "route": {
                      "enum": [
                        "artifact-provider",
                        "aggregator-fallback",
                        "identifier-aggregator"
                      ]
                    },
                    "fetched_at": {"type": "string", "format": "date-time"},
                    "artifact_provider": {"type": "string", "minLength": 1},
                    "response_url": {"type": "string", "minLength": 1},
                    "response_format": {"type": "string", "minLength": 1},
                    "response_sha256": {"$ref": "#/$defs/sha256"}
                  }
                }
              }
            ]
          }
        },
        "metadata_resolution": {
          "type": "object",
          "required": [
            "route",
            "artifact",
            "selected_provider",
            "selected_provider_roles",
            "attempts"
          ],
          "properties": {
            "route": {
              "enum": [
                "artifact-provider",
                "aggregator-fallback",
                "identifier-aggregator"
              ]
            },
            "artifact": {
              "type": "object",
              "required": ["provider", "identifier", "provider_roles"],
              "properties": {
                "provider": {"type": "string", "minLength": 1},
                "identifier": {"type": "string", "minLength": 1},
                "provider_roles": {
                  "type": "array",
                  "contains": {"const": "artifact-access"},
                  "items": {"$ref": "#/$defs/providerRole"},
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "selected_provider": {"type": "string", "minLength": 1},
            "selected_provider_roles": {
              "type": "array",
              "items": {"$ref": "#/$defs/providerRole"},
              "uniqueItems": true
            },
            "identity_anchor": {
              "type": "object",
              "required": ["kind", "value", "supplied_by"],
              "properties": {
                "kind": {"const": "doi"},
                "value": {
                  "type": "string",
                  "pattern": "^10\\.\\d{4,9}/[^\\s<>\\\"']+$"
                },
                "supplied_by": {"const": "caller"}
              },
              "additionalProperties": false
            },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["provider", "status", "error"],
                "properties": {
                  "provider": {"type": "string", "minLength": 1},
                  "status": {"enum": ["ok", "error", "not-supported"]},
                  "error": {"type": ["string", "null"]}
                },
                "allOf": [
                  {
                    "if": {"properties": {"status": {"const": "ok"}}},
                    "then": {"properties": {"error": {"type": "null"}}},
                    "else": {"properties": {"error": {"type": "string", "minLength": 1}}}
                  }
                ],
                "additionalProperties": false
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {"route": {"const": "identifier-aggregator"}},
                "required": ["route"]
              },
              "then": {"required": ["identity_anchor"]},
              "else": {
                "properties": {"identity_anchor": false}
              }
            }
          ],
          "additionalProperties": false
        },
        "latex_source": {
          "type": "object",
          "required": [
            "entrypoint",
            "selection",
            "declarations"
          ],
          "properties": {
            "entrypoint": {
              "$ref": "#/$defs/relativePath"
            },
            "selection": {
              "type": "string",
              "minLength": 1
            },
            "declarations": {
              "type": "object",
              "required": [
                "title_tex",
                "authors_tex",
                "doi"
              ],
              "properties": {
                "title_tex": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "authors_tex": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "doi": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "package_control_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fingerprintRecord"
          }
        }
      },
      "allOf": [
        {
          "if": {"required": ["metadata_resolution"]},
          "then": {
            "properties": {
              "provider_metadata": {
                "contains": {
                  "type": "object",
                  "required": ["role"],
                  "properties": {"role": {"const": "api-metadata-bundle"}}
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["provider_metadata"],
            "properties": {
              "provider_metadata": {
                "contains": {
                  "type": "object",
                  "required": ["role"],
                  "properties": {"role": {"const": "api-metadata-bundle"}}
                }
              }
            }
          },
          "then": {"required": ["metadata_resolution"]}
        }
      ],
      "additionalProperties": true
    },
    "source_forms": {
      "type": "array",
      "minItems": 2,
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "latex-source-archive"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/fileRecord"
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "latex-source-archive"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "required": [
                "sha256",
                "archive_kind"
              ],
              "properties": {
                "archive_kind": {
                  "enum": [
                    "tar+gzip",
                    "single-tex+gzip"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "latex-source-tree"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "required": [
                "derived_from",
                "entrypoint",
                "entrypoint_selection",
                "files",
                "tex_files",
                "sha256"
              ],
              "properties": {
                "derived_from": {
                  "$ref": "#/$defs/relativePath"
                },
                "entrypoint": {
                  "$ref": "#/$defs/relativePath"
                },
                "entrypoint_selection": {
                  "type": "string",
                  "minLength": 1
                },
                "files": {
                  "type": "integer",
                  "minimum": 1
                },
                "tex_files": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "latex-source-tree"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "validated_utc",
        "publication",
        "checks"
      ],
      "properties": {
        "status": {
          "const": "valid"
        },
        "validated_utc": {
          "type": "string",
          "format": "date-time"
        },
        "publication": {
          "enum": [
            "published-new-tree",
            "recovered-existing-tree"
          ]
        },
        "checks": {
          "$ref": "#/$defs/probeLedger"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "portableLeaf": {
      "type": "string",
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))(?!\\.{1,2}$)(?!.*[ .]$)[^<>:\"/\\\\|?*\\u0000-\\u001F]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!(?:.*\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|\/|$))(?!(?:.*\/)?\\.{1,2}(?:\/|$))(?!.*[ .](?:\/|$))(?!.*[<>:\"\\\\|?*\\u0000-\\u001F])[^/]+(?:/[^/]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "providerRole": {
      "enum": [
        "artifact-origin",
        "artifact-access",
        "metadata-authority",
        "metadata-aggregator"
      ]
    },
    "probeLedger": {
      "description": "One entry per probe the deposit transaction is accountable for. An outcome other than 'passed' requires a reason, so a probe that did not apply is distinguishable from one that held. Additional keys carry per-probe detail.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "outcome"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "not-applicable",
              "waived"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "not": {
                    "const": "passed"
                  }
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "fingerprintRecord": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    },
    "fileRecord": {
      "type": "object",
      "required": [
        "role",
        "path",
        "format"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
