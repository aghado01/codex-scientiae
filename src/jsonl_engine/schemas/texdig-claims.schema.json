{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-scientiae/texdig-claims/0.2",
  "title": "TeXdig 0.2 pillar claim",
  "type": "object",
  "required": ["pillar", "span", "role"],
  "properties": {
    "pillar": { "enum": ["envelope", "spine", "fence"] },
    "entityId": { "type": "string", "pattern": "^ent:" },
    "span": {
      "type": "object",
      "required": ["sourceId", "startUtf16", "endUtf16"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "startUtf16": { "type": "integer", "minimum": 0 },
        "endUtf16": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "role": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
