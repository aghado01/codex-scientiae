{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-scientiae/texdig-summary/0.3",
  "title": "TeXdig 0.3 bundle summary",
  "type": "object",
  "required": [
    "schema",
    "slug",
    "treeSha256",
    "entrypoint",
    "stores",
    "storeSchemas",
    "runtime",
    "sourceCount",
    "occurrenceCount",
    "bindingRowCount",
    "invocationCount",
    "entityCounts",
    "agreementCounts",
    "diagnosticCounts",
    "coverage"
  ],
  "properties": {
    "schema": { "const": "texdig-census/0.3" },
    "slug": { "type": "string", "minLength": 1 },
    "treeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entrypoint": { "type": "string", "minLength": 1 },
    "stores": {
      "type": "object",
      "required": ["emitted", "deferred"],
      "properties": {
        "emitted": {
          "const": [
            "sources.jsonl",
            "entities.jsonl",
            "occurrences.jsonl",
            "bindings.jsonl",
            "invocations.jsonl",
            "claims.jsonl",
            "coverage.json",
            "diagnostics.jsonl",
            "summary.json"
          ]
        },
        "deferred": {
          "const": [
            "expansion.jsonl",
            "walk.jsonl",
            "zones.jsonl",
            "macros.jsonl",
            "references.jsonl",
            "pointers.jsonl",
            "frontmatter.jsonl",
            "graph.jsonl"
          ]
        }
      },
      "additionalProperties": false
    },
    "storeSchemas": {
      "type": "object",
      "required": [
        "sources.jsonl",
        "entities.jsonl",
        "claims.jsonl",
        "coverage.json",
        "diagnostics.jsonl",
        "occurrences.jsonl",
        "bindings.jsonl",
        "invocations.jsonl",
        "summary.json"
      ],
      "properties": {
        "sources.jsonl": { "const": "codex-scientiae/texdig-sources/0.2" },
        "entities.jsonl": { "const": "codex-scientiae/texdig-entities/0.3" },
        "claims.jsonl": { "const": "codex-scientiae/texdig-claims/0.2" },
        "coverage.json": { "const": "codex-scientiae/texdig-coverage/0.2" },
        "diagnostics.jsonl": { "const": "codex-scientiae/texdig-diagnostics/0.3" },
        "occurrences.jsonl": { "const": "codex-scientiae/texdig-occurrences/0.3" },
        "bindings.jsonl": { "const": "codex-scientiae/texdig-bindings/0.3" },
        "invocations.jsonl": { "const": "codex-scientiae/texdig-invocations/0.3" },
        "summary.json": { "const": "codex-scientiae/texdig-summary/0.3" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["node"],
      "properties": { "node": { "type": "string", "pattern": "^v[0-9]+\\." } },
      "additionalProperties": false
    },
    "sourceCount": { "type": "integer", "minimum": 1 },
    "occurrenceCount": { "type": "integer", "minimum": 0 },
    "bindingRowCount": { "type": "integer", "minimum": 0 },
    "invocationCount": { "type": "integer", "minimum": 0 },
    "entityCounts": {
      "type": "object",
      "properties": {
        "macro-invocation": { "type": "integer", "minimum": 0 },
        "macro-definition": { "type": "integer", "minimum": 0 },
        "environment-definition": { "type": "integer", "minimum": 0 },
        "environment": { "type": "integer", "minimum": 0 },
        "math": { "type": "integer", "minimum": 0 },
        "verbatim-inline": { "type": "integer", "minimum": 0 },
        "comment": { "type": "integer", "minimum": 0 },
        "paragraph-break": { "type": "integer", "minimum": 0 },
        "include": { "type": "integer", "minimum": 0 },
        "envelope-marker": { "type": "integer", "minimum": 0 },
        "bib-entry": { "type": "integer", "minimum": 0 },
        "bib-string": { "type": "integer", "minimum": 0 },
        "bib-preamble": { "type": "integer", "minimum": 0 },
        "bib-comment": { "type": "integer", "minimum": 0 },
        "bib-field": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "agreementCounts": {
      "type": "object",
      "properties": {
        "agreed": { "type": "integer", "minimum": 0 },
        "lexical-only": { "type": "integer", "minimum": 0 },
        "parser-only": { "type": "integer", "minimum": 0 },
        "conflict": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "diagnosticCounts": {
      "type": "object",
      "properties": {
        "info": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "defect": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["totalUtf16", "claimedUtf16", "residueUtf16", "residueSegments"],
      "properties": {
        "totalUtf16": { "type": "integer", "minimum": 0 },
        "claimedUtf16": { "type": "integer", "minimum": 0 },
        "residueUtf16": { "type": "integer", "minimum": 0 },
        "residueSegments": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
