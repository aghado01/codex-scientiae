    "work": {
      "title": "Agentic Context Engineering: Evolving Contexts for Self-Improving Language Models",
      "authors": [
        "Qizheng Zhang",
        "Changran Hu",
        "Shubhangi Upasani",
        "Boyuan Ma",
        "Fenglu Hong",
        "Vamsidhar Kamanuru",
        "Jay Rainton",
        "Chen Wu",
        "Mengmeng Ji",
