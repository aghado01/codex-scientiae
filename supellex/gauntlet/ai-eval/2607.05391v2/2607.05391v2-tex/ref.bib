	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning},
	file = {Full Text PDF:/Users/depetrol/Zotero/storage/SWECMWPR/Shao et al. - 2024 - DeepSeekMath Pushing the Limits of Mathematical Reasoning in Open Language Models.pdf:application/pdf;Snapshot:/Users/depetrol/Zotero/storage/Y6QQAEXN/2402.html:text/html},
