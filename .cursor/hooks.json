{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "C:\\Users\\azrie\\PDenv\\PowerShell\\PowerShell-7.6.2-win-x64-cursor-ide\\pwsh.exe -NoProfile -File .cursor/hooks/membrane-governance.ps1 -CursorEvent beforeShellExecution",
        "matcher": "mcp-server\\.ps1|serving\\.ps1|preprocess\\.ps1|/src/.*\\.ps1"
      }
    ],
    "beforeReadFile": [
      {
        "command": "C:\\Users\\azrie\\PDenv\\PowerShell\\PowerShell-7.6.2-win-x64-cursor-ide\\pwsh.exe -NoProfile -File .cursor/hooks/membrane-governance.ps1 -CursorEvent beforeReadFile",
        "matcher": "\\.runs/|\\.chunks\\.jsonl|\\.nodes\\.jsonl"
      }
    ],
    "preToolUse": [
      {
        "command": "C:\\Users\\azrie\\PDenv\\PowerShell\\PowerShell-7.6.2-win-x64-cursor-ide\\pwsh.exe -NoProfile -File .cursor/hooks/membrane-governance.ps1 -CursorEvent preToolUse",
        "matcher": "Write|StrReplace"
      }
    ],
    "stop": [
      {
        "command": "C:\\Users\\azrie\\PDenv\\PowerShell\\PowerShell-7.6.2-win-x64-cursor-ide\\pwsh.exe -NoProfile -File .cursor/hooks/membrane-governance.ps1 -CursorEvent stop"
      }
    ]
  }
}
