<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin process boundary over the reusable engine. It intentionally does not
       establish a persisted SpanBatch wire format while that contract is unsettled. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>doccer</AssemblyName>
    <RootNamespace>CodexSci.Doccer.Cli</RootNamespace>
    <EnableSharedSourceRouting>false</EnableSharedSourceRouting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Doccer.csproj" />
  </ItemGroup>

</Project>
